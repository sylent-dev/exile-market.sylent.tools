---
// The donation banner, one thin line above the header (docs/branding.md, Components): the
// sentence in grey, then the link to the donation page in red, white under the pointer or the
// keyboard focus. Its 700 weight, not only its hue, tells the link from the text around it
// (WCAG 1.4.1). On a screen too narrow for one line, the link goes to a second one, whole: from
// 360 px, scripts/check-overflow.mjs fails if it does, since the height of the first screen counts
// on one line (src/styles/tokens.css, --first-screen-rest). An aside, named for screen readers.
import { donationPage } from "../lib/application";
import { type Lang, ui } from "../lib/i18n";
import ExternalLink from "./external-link.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { donation } = ui(lang);
---

<aside class="donation-banner" aria-label={donation.label}>
  <p data-one-line="360">
    <span>{donation.free}</span>
    <ExternalLink href={donationPage} lang={lang}>
      {donation.support}
    </ExternalLink>
  </p>
</aside>

<style>
  .donation-banner {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--height-donation-banner);
    padding: var(--space-2) var(--space-4);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-background);
    color: var(--color-text-faint);
    font-size: var(--size-label);
    line-height: 1.2;
    text-align: center;
  }

  p {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2);
    justify-content: center;
    margin: 0;
  }

  span,
  a {
    white-space: nowrap;
  }

  /* A taller target for a finger, without a taller banner. */
  a {
    margin-block: calc(-1 * var(--space-2));
    padding-block: var(--space-2);
    color: var(--color-accent);
    font-weight: 700;
    text-decoration: none;
  }

  a:hover,
  a:focus-visible {
    color: var(--color-text);
  }
</style>
