---
// What the tool does: three real screens of the application, overlapping. The card under the
// mouse, tapped or focused comes in front, and its text shows. Without JavaScript, the three texts
// are all shown, so that nothing is lost. On a computer with a mouse, a click on the card in front
// opens its screen in a lightbox, larger, where the visitor goes from one screen to the next.
import { getImage, Image } from "astro:assets";
import copyEn from "../assets/screens/en/copy.png";
import filtersEn from "../assets/screens/en/filters.png";
import priceEn from "../assets/screens/en/price.png";
import copyFr from "../assets/screens/fr/copy.png";
import filtersFr from "../assets/screens/fr/filters.png";
import priceFr from "../assets/screens/fr/price.png";
import type en from "../content/en/home.json";
import { withNewTabs } from "../lib/external-link";
import type { Lang } from "../lib/i18n";
import Lightbox from "./lightbox.astro";

interface Props {
  lang: Lang;
  texts: (typeof en)["features"];
}

const { lang, texts } = Astro.props;
const { cards, lightbox } = texts;
const screens = {
  en: [copyEn, priceEn, filtersEn],
  fr: [copyFr, priceFr, filtersFr],
}[lang];

// The screen of the lightbox at the width of the capture: 420 px on the screen, at twice the
// density. It is downloaded only when the lightbox opens.
const large = await Promise.all(
  screens.map((screen) => getImage({ src: screen, width: 840 })),
);

// The price is in front until the visitor picks another card.
const inFront = 1;
---

<div class="deck">
  <div class="deck-stage">
    <div class="deck-cards">
      {cards.map(({ alt, title }, index) => (
        <button
          class:list={["deck-card", { "is-active": index === inFront }]}
          type="button"
          style={{ "--i": index }}
          aria-current={index === inFront ? "true" : undefined}
          data-deck-card
          data-large={large[index]!.src}
          data-title={title}
        >
          <Image
            src={screens[index]!}
            alt={alt}
            widths={[260, 520]}
            sizes="(width <= 720px) 46vw, 263px"
          />
        </button>
      ))}
    </div>
  </div>
  <div class="deck-texts" aria-live="polite">
    {cards.map(({ title, body }, index) => (
      <div class="deck-text" hidden={index !== inFront} data-deck-text>
        <h3>{title}</h3>
        <p set:html={withNewTabs(body, lang)} />
      </div>
    ))}
  </div>
</div>

<Lightbox lang={lang} label={lightbox.label} data-deck-lightbox>
  <span
    class="lightbox-counter"
    slot="top"
    aria-hidden="true"
    data-lightbox-part
    data-lightbox-counter
  ></span>
  <figure class="lightbox-figure" data-lightbox-close>
    <div class="lightbox-row" data-lightbox-close>
      <button
        class="lightbox-button"
        type="button"
        aria-label={lightbox.previous}
        data-lightbox-part
        data-lightbox-button="previous"
      >
        <svg
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12.5 4.5L7 10l5.5 5.5"></path>
        </svg>
      </button>
      <div class="lightbox-screen" data-lightbox-screen></div>
      <button
        class="lightbox-button"
        type="button"
        aria-label={lightbox.next}
        data-lightbox-part
        data-lightbox-button="next"
      >
        <svg
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M7.5 4.5L13 10l-5.5 5.5"></path>
        </svg>
      </button>
    </div>
    <figcaption
      class="lightbox-title"
      aria-live="polite"
      data-lightbox-part
      data-lightbox-caption
      data-position={lightbox.position}
    >
      <span data-lightbox-title></span>
      <span class="visually-hidden" data-lightbox-position></span>
    </figcaption>
  </figure>
</Lightbox>

<script>
  import {
    createLightbox,
    easeOut,
    play,
    reducedMotion,
    withMouse,
  } from "../lib/lightbox";

  const cards = [
    ...document.querySelectorAll<HTMLButtonElement>("[data-deck-card]"),
  ];
  const texts = [...document.querySelectorAll<HTMLElement>("[data-deck-text]")];
  let current = cards.findIndex((card) => card.classList.contains("is-active"));

  const bringToFront = (chosen: HTMLButtonElement) => {
    current = cards.indexOf(chosen);
    cards.forEach((card, index) => {
      card.classList.toggle("is-active", index === current);
      if (index === current) card.setAttribute("aria-current", "true");
      else card.removeAttribute("aria-current");
    });
    texts.forEach((text, index) => {
      text.hidden = index !== current;
    });
  };

  // ---- The lightbox, only with a mouse: on a touch screen, the tap brings a card in front, and
  // two fingers zoom. ----
  const lightbox = document.querySelector<HTMLDialogElement>(
    "[data-deck-lightbox]",
  );
  const screen = lightbox?.querySelector<HTMLElement>("[data-lightbox-screen]");
  const caption = lightbox?.querySelector<HTMLElement>(
    "[data-lightbox-caption]",
  );
  const title = caption?.querySelector<HTMLElement>("[data-lightbox-title]");
  const position = caption?.querySelector<HTMLElement>(
    "[data-lightbox-position]",
  );
  const counter = lightbox?.querySelector<HTMLElement>(
    "[data-lightbox-counter]",
  );
  // The image of the screen shown, swapped for the one of the next card.
  let image = document.createElement("img");

  // The larger screen of a card is fetched as soon as the mouse brings it in front, so that the
  // lightbox opens at once; the others, once it is open, for the arrows. The lightbox shows that
  // same image, so that it is never asked for twice, whatever the cache says.
  const screens = new Map<
    string,
    { element: HTMLImageElement; ready: Promise<void> }
  >();
  const preload = (card: HTMLButtonElement | undefined) => {
    const address = card?.dataset.large;
    if (!address || screens.has(address)) return;
    const element = new Image();
    element.src = address;
    element.alt = card.querySelector("img")?.alt ?? "";
    // The screen is decoded before it moves, so that it never travels empty.
    screens.set(address, {
      element,
      ready: element.decode().catch(() => undefined),
    });
  };

  const fill = async () => {
    const card = cards[current]!;
    preload(card);
    const shown = screens.get(card.dataset.large ?? "");
    await shown?.ready;
    if (shown && shown.element !== image) {
      for (const animation of image.getAnimations()) animation.cancel();
      screen?.replaceChildren(shown.element);
      image = shown.element;
    }
    if (title) title.textContent = card.dataset.title ?? "";
    if (counter) counter.textContent = `${current + 1} / ${cards.length}`;
    if (position)
      position.textContent = ` ${caption?.dataset.position ?? ""}`
        .replace("{current}", String(current + 1))
        .replace("{total}", String(cards.length));
  };

  const box =
    lightbox && screen && caption
      ? createLightbox({
          dialog: lightbox,
          traveller: screen,
          // The card leaves the deck while its screen travels, and comes back once it lands.
          origin: () => cards[current]!,
          prepare: fill,
          opened: () => cards.forEach(preload),
          // The focus goes back to the card in front.
          closed: () => cards[current]?.focus({ preventScroll: true }),
        })
      : undefined;

  const go = (step: number) =>
    box?.run(async () => {
      const motion = !reducedMotion.matches;
      const shift = (sign: number) => `translateX(${sign * step * 48}px)`;
      if (motion)
        await Promise.all([
          play(image, [{ opacity: 1 }, { opacity: 0, transform: shift(-1) }], {
            duration: 150,
            easing: "ease-in",
          }),
          play(caption!, [{ opacity: 1 }, { opacity: 0 }], { duration: 150 }),
        ]);
      bringToFront(cards[(current + step + cards.length) % cards.length]!);
      await fill();
      if (motion)
        await Promise.all([
          play(image, [{ opacity: 0, transform: shift(1) }, { opacity: 1 }], {
            duration: 230,
            easing: easeOut,
          }),
          play(caption!, [{ opacity: 0 }, { opacity: 1 }], { duration: 230 }),
        ]);
      for (const element of [image, caption!])
        for (const animation of element.getAnimations()) animation.cancel();
    });

  lightbox?.addEventListener("click", (event) => {
    const button = (event.target as HTMLElement).closest<HTMLElement>(
      "[data-lightbox-button]",
    );
    const steps: Record<string, number> = { previous: -1, next: 1 };
    const step = steps[button?.dataset.lightboxButton ?? ""];
    if (step) void go(step);
  });
  lightbox?.addEventListener("keydown", (event) => {
    const steps: Record<string, number> = { ArrowLeft: -1, ArrowRight: 1 };
    const step = steps[event.key];
    if (!step) return;
    event.preventDefault();
    void go(step);
  });

  // The deck holds still while the lightbox opens or is open, so that the card that opened it
  // stays the one in front.
  const isFrozen = () => box?.isFrozen() ?? false;

  // Screen readers hear that the card opens a window, where it does.
  const markOpening = () => {
    for (const card of cards) {
      if (withMouse.matches) card.setAttribute("aria-haspopup", "dialog");
      else card.removeAttribute("aria-haspopup");
    }
  };
  markOpening();
  withMouse.addEventListener("change", markOpening);

  for (const card of cards) {
    card.addEventListener("pointerover", (event) => {
      if (event.pointerType !== "mouse" || isFrozen()) return;
      bringToFront(card);
      preload(card);
    });
    // A touch on a laptop with a touch screen brings the card in front, as on a phone; Enter,
    // whose click has no pointer type, opens it.
    card.addEventListener("click", (event) => {
      if (isFrozen()) return;
      bringToFront(card);
      const touched =
        event instanceof PointerEvent && event.pointerType === "touch";
      if (withMouse.matches && !touched) void box?.open();
    });
    card.addEventListener("focus", () => {
      if (!isFrozen()) bringToFront(card);
    });
  }
</script>

<style>
  .deck {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-12);
    align-items: center;
  }

  /* The cards follow the width of their column, so that they never reach the text. */
  .deck-stage {
    display: grid;
    justify-items: center;
    container-type: inline-size;
  }

  .deck-cards {
    --card: clamp(130px, 44cqi, 250px);

    position: relative;
    width: calc(var(--card) * 2.1);
    height: calc(var(--card) * 12 / 7 * 1.05);
  }

  /* The middle card lies over the two others, as in a hand, so that each keeps a side to point
     at; the chosen card comes in front of all. */
  .deck-card {
    position: absolute;
    z-index: 1;
    top: 50%;
    left: calc(50% - var(--card) / 2);
    width: var(--card);
    padding: 0;
    border: 0;
    background: #000000;
    box-shadow: 0 18px 40px #000000cc;
    cursor: pointer;
    filter: brightness(0.5);
    transform: translate(calc((var(--i) - 1) * 52%), -50%);
    transition:
      transform 0.35s var(--ease-draw),
      filter 0.3s;
  }

  .deck-card:nth-child(2) {
    z-index: 2;
  }

  .deck-card.is-active {
    z-index: 3;
    filter: none;
    transform: translate(calc((var(--i) - 1) * 52%), -50%) scale(1.05);
  }

  /* While its screen travels to the lightbox or back, the card has left the deck. */
  .deck-card.is-away {
    visibility: hidden;
  }

  .deck-card :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 7 / 12;
  }

  /* With a mouse, the card in front says that it opens. */
  @media (hover: hover) and (pointer: fine) and (scripting: enabled) {
    .deck-card.is-active {
      cursor: zoom-in;
    }
  }

  /* On a computer, each title holds on one line: its size follows the width of its column. */
  .deck-texts {
    container-type: inline-size;
  }

  .deck-text h3 {
    font-size: min(var(--size-title), 7.2cqi);
    white-space: nowrap;
  }

  .deck-text p {
    max-width: 21.25em;
    margin-top: var(--space-2);
    color: var(--color-text-weak);
    font-size: var(--size-subtitle);
  }

  /* The three texts share one cell, so that the tallest gives its height to the block and the
     title doesn't move from one card to the next. */
  @media (width >= 721px) and (scripting: enabled) {
    .deck-texts {
      display: grid;
    }

    .deck-text {
      grid-area: 1 / 1;
    }

    .deck-text[hidden] {
      display: block;
      visibility: hidden;
    }
  }

  /* Without JavaScript, the cards can't be picked: none is dimmed, and every text shows. */
  @media (scripting: none) {
    .deck-card {
      cursor: default;
      filter: none;
    }

    .deck-text[hidden] {
      display: block;
    }

    .deck-text + .deck-text {
      margin-top: var(--space-6);
    }
  }

  /* On a phone, the text goes under the cards, centered. */
  @media (width <= 720px) {
    .deck {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .deck-texts {
      justify-self: center;
      container-type: normal;
    }

    .deck-text {
      min-height: 6.5em;
      text-align: center;
    }

    .deck-text h3 {
      font-size: inherit;
      white-space: normal;
    }

    .deck-text p {
      margin-top: var(--space-1);
      font-size: inherit;
    }
  }

  /* At the top left, across from the cross. */
  .lightbox-counter {
    margin-right: auto;
    color: var(--color-text-faint);
    font-size: var(--size-label);
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }

  .lightbox-figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
    margin: 0;
  }

  .lightbox-row {
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }

  /* The screen at most at its real size, the window of the application being 420 × 720, smaller
     on a short screen, so that its title stays in sight, or on a narrow window, so that its two
     buttons do. The counter and the cross sit in the corners, beside it. */
  .lightbox-screen {
    --screen-height: min(720px, 100svh - 120px, (100vw - 220px) * 12 / 7);

    width: calc(var(--screen-height) * 7 / 12);
    height: var(--screen-height);
  }

  .lightbox-screen :global(img) {
    width: 100%;
    height: 100%;
    box-shadow: var(--shadow-screen);
  }

  .lightbox-title {
    font-family: var(--font-title);
    font-size: var(--size-lightbox-title);
    font-weight: var(--weight-title);
    letter-spacing: var(--tracking-title);
    line-height: var(--line-title);
    text-align: center;
  }
</style>
