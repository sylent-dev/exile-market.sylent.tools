---
// An outlined link: the download buttons, and the way back to the home page. Under the pointer or
// the keyboard focus, a red line with a glow draws itself clockwise over its border. `main` gives
// it the white border of the main action. The border is drawn in SVG like the red line, so that
// both land on the same pixels: a CSS border, snapped to the pixel on its own, left a strip of
// white beside the red line when the button sat between two pixels (owner, 2026-11-14; checked
// by scripts/check-button-line.mjs). The label stays on one line, and the width check
// (scripts/check-overflow.mjs) fails when it is cut.
interface Props {
  href: string;
  main?: boolean;
}

const { href, main = false } = Astro.props;
---

<a class:list={["outline-button", { "is-main": main }]} href={href}>
  <span data-one-line>
    <slot />
  </span>
  <svg class="button-border" aria-hidden="true">
    <rect></rect>
  </svg>
  <svg class="button-line is-glow" aria-hidden="true">
    <rect pathLength="1"></rect>
  </svg>
  <svg class="button-line" aria-hidden="true">
    <rect pathLength="1"></rect>
  </svg>
</a>

<style>
  /* isolation keeps the glow behind the text and in front of what is behind the button. */
  .outline-button {
    --border-color: var(--color-button-line);

    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--height-button);
    padding: 0 var(--space-6);
    border: 1px solid transparent;
    color: var(--color-text);
    font-family: var(--font-title);
    font-weight: 600;
    letter-spacing: var(--tracking-button);
    text-decoration: none;
    white-space: nowrap;
    isolation: isolate;
  }

  .outline-button:hover {
    color: var(--color-text);
  }

  .is-main {
    --border-color: var(--color-text);
  }

  /* The border and the red line share one box, the outer edge of the border: an absolute box is
     placed from the inner edge, 1 px further in. */
  .button-border,
  .button-line {
    position: absolute;
    inset: -1px;
    overflow: visible;
    width: calc(100% + 2px);
    max-width: none;
    height: calc(100% + 2px);
    pointer-events: none;
  }

  .button-line.is-glow {
    z-index: -1;
    filter: drop-shadow(0 0 3px var(--color-accent-deep))
      drop-shadow(0 0 10px var(--color-accent-deep));
  }

  /* The border and the red line follow the same path, the middle of the border: the red line, 2 px
     wide, covers the border, 1 px wide, with half a pixel to spare on each side, so that no white
     shows beside it even when the two are rounded to different pixels. */
  .button-border rect,
  .button-line rect {
    x: 0.5px;
    y: 0.5px;
    width: calc(100% - 1px);
    height: calc(100% - 1px);
    fill: none;
  }

  .button-border rect {
    stroke: var(--border-color);
    stroke-width: 1px;
  }

  .button-line rect {
    stroke: var(--color-accent-deep);
    stroke-width: 2px;
    stroke-linecap: square;
    stroke-dasharray: 1 1;
    stroke-dashoffset: 1;
    opacity: 0;
    transition:
      stroke-dashoffset var(--draw-out),
      opacity 0s linear 0.25s;
  }

  .outline-button:hover .button-line rect,
  .outline-button:focus-visible .button-line rect {
    stroke-dashoffset: 0;
    opacity: 1;
    transition:
      stroke-dashoffset var(--draw-in),
      opacity 0s;
  }

  @media (prefers-reduced-motion: reduce) {
    .button-line rect,
    .outline-button:hover .button-line rect,
    .outline-button:focus-visible .button-line rect {
      transition: none;
    }
  }

  /* In high contrast mode, the browser forces the colors of a CSS border but not those of an SVG
     stroke: the border takes the color of the links, as the CSS border did. */
  @media (forced-colors: active) {
    .button-border rect {
      stroke: LinkText;
    }
  }
</style>
