---
// The video of the first screen, in the language of the page. The still image is always there, and
// shows alone without JavaScript or with reduced motion; the video lies over it, transparent until
// it has a frame, and the script starts it. A click on it pauses it; on a computer with a mouse, a
// button in its corner opens it in a lightbox, at most at its real size, where it keeps playing.
import { Image } from "astro:assets";
import deckEnMp4 from "../assets/video/deck-en.mp4";
import deckEnWebm from "../assets/video/deck-en.webm";
import deckFrMp4 from "../assets/video/deck-fr.mp4";
import deckFrWebm from "../assets/video/deck-fr.webm";
import stillEn from "../assets/video/still-en.jpg";
import stillFr from "../assets/video/still-fr.jpg";
import type en from "../content/en/home.json";
import { donationsOpen } from "../lib/application";
import type { Lang } from "../lib/i18n";
import Lightbox from "./lightbox.astro";

interface Props {
  lang: Lang;
  texts: (typeof en)["video"];
}

const { lang, texts } = Astro.props;
const still = { en: stillEn, fr: stillFr }[lang];
const sources = {
  en: { webm: deckEnWebm, mp4: deckEnMp4 },
  fr: { webm: deckFrWebm, mp4: deckFrMp4 },
}[lang];

// The width the image is shown at: --gutter, --first-screen-base, --height-donation-banner and its
// border, and --video-ceiling of src/styles/tokens.css, written out since an HTML attribute can't
// read a variable.
const firstScreenBase = 380;
const donationBannerHeight = 36 + 1;
const firstScreenRest =
  firstScreenBase + (donationsOpen ? donationBannerHeight : 0);
const stillSizes = `min(100vw - 40px, clamp(400px, (100vh - ${firstScreenRest}px) * 16 / 9, 960px))`;
---

<div class="hero-video">
  <div class="media-frame">
    <Image
      class="media-still"
      src={still}
      alt={texts.still}
      widths={[640, 960, 1280]}
      sizes={stillSizes}
      loading="eager"
      fetchpriority="high"
    />
    <video
      class="media-video"
      muted
      loop
      playsinline
      preload="none"
      aria-hidden="true"
    >
      <source src={sources.webm} type='video/webm; codecs="vp9"' />
      <source src={sources.mp4} type='video/mp4; codecs="avc1.64001f"' />
    </video>
    <button
      type="button"
      class="media-toggle"
      aria-label={texts.play}
      data-play={texts.play}
      data-pause={texts.pause}
      data-video-toggle
      hidden
    >
      <span class="media-disc">
        <svg
          width="26"
          height="26"
          viewBox="0 0 26 26"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M8 4.5v17l14-8.5z"></path>
        </svg>
      </span>
    </button>
    <button
      type="button"
      class="media-enlarge"
      aria-label={texts.enlarge}
      aria-haspopup="dialog"
      data-video-enlarge
      hidden
    >
      <svg
        width="14"
        height="14"
        viewBox="0 0 14 14"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M8.5 1.5h4v4M12.5 1.5L8 6M5.5 12.5h-4v-4M1.5 12.5L6 8"></path>
      </svg>
    </button>
  </div>
</div>

<Lightbox label={texts.lightbox} close={texts.close} data-video-lightbox>
  <div class="lightbox-video" data-lightbox-video>
    <button
      type="button"
      class="media-toggle"
      aria-label={texts.pause}
      data-play={texts.play}
      data-pause={texts.pause}
      data-video-toggle
    >
      <span class="media-disc">
        <svg
          width="26"
          height="26"
          viewBox="0 0 26 26"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M8 4.5v17l14-8.5z"></path>
        </svg>
      </span>
    </button>
  </div>
</Lightbox>

<script>
  import { createLightbox, reducedMotion } from "../lib/lightbox";

  const box = document.querySelector<HTMLElement>(".hero-video");
  const frame = box?.querySelector<HTMLElement>(".media-frame");
  const video = box?.querySelector("video");
  const button = box?.querySelector<HTMLButtonElement>("[data-video-toggle]");
  const enlarge = box?.querySelector<HTMLButtonElement>("[data-video-enlarge]");
  const dialog = document.querySelector<HTMLDialogElement>(
    "[data-video-lightbox]",
  );
  const screen = dialog?.querySelector<HTMLElement>("[data-lightbox-video]");
  // The button over the video on the page, and the one over it in the lightbox.
  const toggles = [
    ...document.querySelectorAll<HTMLButtonElement>("[data-video-toggle]"),
  ];

  if (box && frame && video && button && enlarge && dialog && screen) {
    // What the visitor wants, apart from what the screen shows: out of sight, the video stops but
    // its button still says it plays. Nothing is kept for the next visit.
    let wanted = !reducedMotion.matches;
    let inSight = false;
    // In the lightbox, the video is in sight wherever the page was left.
    const seen = () => inSight || dialog.open;

    const showState = () => {
      for (const toggle of toggles) {
        toggle.classList.toggle("is-playing", wanted);
        toggle.setAttribute(
          "aria-label",
          (wanted ? toggle.dataset.pause : toggle.dataset.play) ?? "",
        );
      }
    };

    const refuse = (error: DOMException) => {
      // A pause or a scroll cut a start short: nothing went wrong.
      if (error.name === "AbortError") return;
      // The browser refused to start the video (a battery saver): the still image stays, with the
      // play button.
      wanted = false;
      showState();
    };

    const apply = () => {
      showState();
      if (wanted && seen()) video.play().catch(refuse);
      else video.pause();
    };

    // No source could be loaded (no network, a blocker): the last one fails, and play() neither
    // ends nor rejects. The still image stays, without buttons that would do nothing.
    video
      .querySelector("source:last-of-type")
      ?.addEventListener("error", () => {
        wanted = false;
        button.hidden = true;
        enlarge.hidden = true;
        showState();
      });

    // The lightbox opens only on a video that has a frame to show.
    video.addEventListener("loadeddata", () => {
      enlarge.hidden = false;
    });

    // Stopped by the system or the browser rather than by this script: the button tells so. Paused
    // is read again, since the event may come after a new start.
    video.addEventListener("pause", () => {
      if (video.paused && wanted && seen() && !document.hidden) {
        wanted = false;
        showState();
      }
    });

    button.hidden = false;
    showState();

    for (const toggle of toggles)
      toggle.addEventListener("click", () => {
        wanted = !wanted;
        apply();
      });

    // The same video goes into the lightbox and comes back, so that it keeps playing where it was
    // and is never downloaded twice; the still image waits in its place.
    const lightbox = createLightbox({
      dialog,
      traveller: screen,
      origin: () => frame,
      prepare: () => {
        screen.prepend(video);
      },
      closed: () => {
        frame.insertBefore(video, button);
        enlarge.focus({ preventScroll: true });
        apply();
      },
    });
    enlarge.addEventListener("click", () => void lightbox.open());

    // Several changes may come at once, the latest one last.
    new IntersectionObserver((entries) => {
      inSight = entries.at(-1)?.isIntersecting ?? false;
      apply();
    }).observe(box);

    reducedMotion.addEventListener("change", () => {
      if (!reducedMotion.matches) return;
      wanted = false;
      apply();
    });

    // The slight tilt under a mouse, and never with reduced motion. At most one update per frame,
    // and none out of sight.
    const TILT_AROUND_Y = 4.5;
    const TILT_AROUND_X = 3.5;
    let mouse = { x: 0, y: 0 };
    let frameRequest = 0;

    const tilt = () => {
      frameRequest = 0;
      box.style.setProperty("--tilt-y", `${mouse.x * TILT_AROUND_Y}deg`);
      box.style.setProperty("--tilt-x", `${-mouse.y * TILT_AROUND_X}deg`);
    };

    const lean = (x: number, y: number) => {
      mouse = { x, y };
      if (!frameRequest) frameRequest = requestAnimationFrame(tilt);
    };

    // A finger or a pen puts the video back flat, as it drops the mouse for the red grid.
    const follow = (event: PointerEvent) => {
      if (event.pointerType !== "mouse" || reducedMotion.matches) {
        lean(0, 0);
        return;
      }
      if (!inSight) return;
      lean(
        (event.clientX / window.innerWidth) * 2 - 1,
        (event.clientY / window.innerHeight) * 2 - 1,
      );
    };

    document.addEventListener("pointermove", follow);
    document.addEventListener("pointerdown", follow);
    document.documentElement.addEventListener("mouseleave", () => lean(0, 0));
  }
</script>

<style>
  /* It stays whole: its width follows the height of the window, with a ceiling. */
  .hero-video {
    position: relative;
    width: min(
      100%,
      clamp(
        400px,
        calc((100svh - var(--first-screen-rest)) * 16 / 9),
        var(--video-ceiling)
      )
    );
    margin-top: var(--download-rhythm);
    perspective: var(--tilt-depth);
  }

  .media-frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    transform: rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg));
    transition: transform var(--tilt-time) ease-out;
  }

  /* The line of the frame, over the video, which would otherwise cover it. */
  .media-frame::after {
    position: absolute;
    inset: 0;
    box-shadow: inset 0 0 0 1px var(--color-frame-line);
    content: "";
    pointer-events: none;
  }

  .media-frame :global(.media-still),
  .media-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .media-video {
    position: absolute;
    inset: 0;
  }

  /* The whole video is one button, so that it keeps the keyboard focus: a click anywhere pauses
     it or plays it again; stopped, a large play button stands in its middle. */
  .media-toggle {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
  }

  /* Inside the frame, which would cut an outline around it. */
  .media-toggle:focus-visible {
    outline-offset: -5px;
  }

  .media-disc {
    display: grid;
    place-items: center;
    width: var(--size-media-button-large);
    height: var(--size-media-button-large);
    border-radius: 50%;
    background: var(--color-media-button-large);
  }

  .media-toggle[hidden],
  .media-toggle.is-playing .media-disc {
    display: none;
  }

  /* The button that opens the lightbox, in the bottom right corner, over the one of the video. */
  .media-enlarge {
    position: absolute;
    right: var(--space-2);
    bottom: var(--space-2);
    display: grid;
    place-items: center;
    width: var(--size-media-button);
    height: var(--size-media-button);
    padding: 0;
    border: 0;
    border-radius: var(--radius-media-button);
    background: var(--color-media-button);
    color: var(--color-text);
    cursor: pointer;
  }

  /* Only with a mouse: on a touch screen, two fingers zoom. */
  .media-enlarge[hidden] {
    display: none;
  }

  @media not ((hover: hover) and (pointer: fine)) {
    .media-enlarge {
      display: none;
    }
  }

  /* The video at most at its real size, 1280 × 720, smaller on a small window, so that it never
     reaches the cross above it. */
  .lightbox-video {
    position: relative;
    width: min(
      1280px,
      100vw - 2 * var(--gutter),
      (100svh - 2 * (var(--size-top-button) + 2 * var(--space-5))) * 16 / 9
    );
    aspect-ratio: 16 / 9;
    background: var(--video-neutral);
    box-shadow: var(--shadow-screen);
  }

  /* On a phone, the video comes before the download area, which holds no button. */
  @media (width <= 720px) {
    .hero-video {
      order: 1;
      width: 100%;
      margin-top: var(--space-4);
    }
  }
</style>
