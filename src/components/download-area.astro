---
// The main action of the page. The HTML holds the two buttons, which work alone; a small script
// only replaces them for macOS or a phone (specs.md, Main action). It runs right after the block,
// before the first paint, so that a phone never sees the buttons appear then leave. Last, on every
// system, the link to Discord (discord-message.astro), whose entrance the same script plays once
// it comes into sight: set before the first paint, its waiting state never flashes.
import type en from "../content/en/home.json";
import { downloads, downloadsOpen, releases } from "../lib/application";
import type { Lang } from "../lib/i18n";
import DiscordMessage from "./discord-message.astro";
import ExternalLink from "./external-link.astro";
import OutlineButton from "./outline-button.astro";

interface Props {
  lang: Lang;
  texts: (typeof en)["download"];
}

const { lang, texts } = Astro.props;
---

{downloadsOpen ? (
  <>
    <div class="download">
      <div class="download-buttons">
        <OutlineButton href={downloads.windows} main>
          {texts.windows}
        </OutlineButton>
        <OutlineButton href={downloads.linux}>{texts.linux}</OutlineButton>
      </div>
      <ul class="download-links">
        <li>
          <ExternalLink href={releases} pageLang={lang}>
            {texts.versions}
          </ExternalLink>
        </li>
        <li>
          <a href="#risk">{texts.risk}</a>
        </li>
        <li>
          <a href="#windows-alert">{texts.alert}</a>
        </li>
      </ul>
      <DiscordMessage lang={lang} />
      <template data-system="macos">
        <p class="download-message">{texts.macos}</p>
        <DiscordMessage lang={lang} />
      </template>
      <template data-system="phone">
        <p class="download-message">
          <span data-one-line="360">{texts.phone.computer}</span>{" "}
          <span data-one-line="360">
            {texts.phone.before}{" "}
            <span class="download-address">{texts.phone.address}</span>{" "}
            {texts.phone.after}
          </span>
        </p>
        <ul class="download-links">
          <li>
            <a href="#risk">{texts.risk}</a>
          </li>
          <li>
            <ExternalLink href={releases} pageLang={lang}>
              {texts.versions}
            </ExternalLink>
          </li>
        </ul>
        <DiscordMessage lang={lang} />
      </template>
    </div>
    <script is:inline>
      {
        // Android also calls itself Linux, and an iPad calls itself a Mac: only its touch screen
        // tells them apart, so the phones and tablets are tested first.
        const agent = navigator.userAgent;
        const isMac = agent.includes("Macintosh");
        const isPhone =
          /Android|iPhone|iPad|iPod|Mobi/.test(agent) ||
          (isMac && navigator.maxTouchPoints > 1);
        const system = isPhone ? "phone" : isMac ? "macos" : "computer";
        const area = document.currentScript.previousElementSibling;
        const template = area.querySelector(`[data-system="${system}"]`);
        if (template) area.replaceChildren(template.content);

        const message = area.querySelector(".discord-message");
        const still = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        ).matches;
        if (message && !still && "IntersectionObserver" in window) {
          message.classList.add("is-waiting");
          const watch = new IntersectionObserver(
            ([entry]) => {
              if (!entry?.isIntersecting) return;
              message.classList.add("is-in");
              watch.disconnect();
            },
            { threshold: 0.6 },
          );
          watch.observe(message);
        }
      }
    </script>
  </>
) : (
  <div class="download">
    <p class="download-soon">{texts.soon}</p>
  </div>
)}

<style>
  .download {
    display: flex;
    flex-direction: column;
    gap: var(--download-rhythm);
    align-items: center;
    margin-top: var(--space-4);
  }

  .download-buttons {
    display: inline-grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }

  /* The shape of the main download button, at full contrast so that it reads at once, without
     anything of a link: it stays a text, and does nothing under the pointer. */
  .download-soon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--height-button);
    margin: 0;
    padding: 0 var(--space-6);
    border: 1px solid var(--color-text);
    font-family: var(--font-title);
    font-weight: 600;
    letter-spacing: var(--tracking-button);
    white-space: nowrap;
  }

  /* On a phone, one sentence per line (owner, 2026-11-28). */
  .download-message {
    font-weight: 600;
  }

  .download-message > span {
    display: block;
  }

  .download-address {
    white-space: nowrap;
  }

  /* One link per line, red, white under the pointer, without an underline. */
  .download-links {
    display: grid;
    gap: var(--space-1);
    justify-items: center;
    font-family: var(--font-title);
    font-size: 13px;
    font-weight: 700;
    line-height: 1.3;
    text-shadow: var(--shadow-on-grid);
  }

  .download-links a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .download-links a:hover {
    color: var(--color-text);
  }

  /* On a touch screen, each link stays at least 24 px from the next. */
  @media (pointer: coarse) {
    .download-links {
      gap: var(--space-2);
    }
  }

  /* On a phone, the video comes before the download area (home-page.astro). */
  @media (width <= 720px) {
    .download {
      order: 2;
      gap: var(--space-2);
      align-items: stretch;
      margin-top: var(--space-5);
    }

    .download-buttons {
      grid-template-columns: 1fr;
    }

    /* At 14 px, the longer sentence, the French one, holds on one line from 344 px; at 16 px it
       needed 391 px (owner, 2026-11-28). */
    .download-message {
      font-size: var(--size-label);
    }

    .download-links {
      gap: var(--space-2);
    }

    /* The link to Discord, centered as on a computer, as far below the links. */
    .download > :global(.discord-message) {
      align-self: center;
      margin-top: calc(var(--download-rhythm) - var(--space-2));
    }
  }
</style>
