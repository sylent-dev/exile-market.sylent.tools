   "boundElements": null,
   "updated": 1761231600000,
   "link": null,
   "locked": false,
   "text": "Layout only, no colors: the style comes in the mock-up. Lead B, the timeline, chosen by the owner on 2026-11-19.\nLeft of the rail: the version, its date, and the link to its release on GitHub (files and checksums). Right: the changes.\nOne tag per change, in a fixed order: New, then Changed, then Fixed; the site sorts them, and starts the sentence with a capital. Header: « v0.2.0 », left of the flag, leads here.\nThe texts are the notes of docs/patch-notes/ of the application (v0.2.0 prepared, not released yet).",
   "originalText": "Layout only, no colors: the style comes in the mock-up. Lead B, the timeline, chosen by the owner on 2026-11-19.\nLeft of the rail: the version, its date, and the link to its release on GitHub (files and checksums). Right: the changes.\nOne tag per change, in a fixed order: New, then Changed, then Fixed; the site sorts them, and starts the sentence with a capital. Header: « v0.2.0 », left of the flag, leads here.\nThe texts are the notes of docs/patch-notes/ of the application (v0.2.0 prepared, not released yet).",
   "fontSize": 15,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
