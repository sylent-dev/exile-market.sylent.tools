{
  "name": "exile-market-sylent-tools",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "astro check && eslint . && stylelint \"**/*.{css,astro}\"",
    "check:links": "linkinator dist && node scripts/check-urls.mjs",
    "check:notes": "node scripts/check-patch-notes.mjs",
    "check:overflow": "node scripts/check-overflow.mjs",
    "check:buttons": "node scripts/check-button-line.mjs",
    "check:lightbox": "node scripts/check-lightbox.mjs",
    "check:fluid": "node scripts/check-grid-fluid.mjs",
    "check": "npm run format:check && npm run lint && npm run build && npm run check:links && npm run check:notes && npm run check:overflow && npm run check:buttons && npm run check:lightbox && npm run check:fluid",
    "brand:images": "node scripts/brand-images.mjs"
  },
  "dependencies": {
    "astro": "^7.4.12",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/three": "^0.187.0",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "globals": "^17.14.0",
    "linkinator": "^8.1.0",
    "playwright": "^1.65.1",
    "postcss-html": "^2.0.1",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "stylelint": "^17.16.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
